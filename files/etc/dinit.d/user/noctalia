# noctalia - Cosmalia shell (bar, dock, launcher, notifications, lock screen, etc.)

type = process
command = /usr/bin/noctalia

# Hard dependency on cosmalia-session.target (like PartOf=)
# Stopping cosmalia-session.target stops this service
depends-on: cosmalia-session.target

# Ordering: start after cosmic-settings-daemon
after: cosmic-settings-daemon

# Restart on failure (like systemd Restart=on-failure)
restart = on-failure
restart-delay = 1
stop-timeout = 5